<%- include("../partials/head", { title: title, nav: "shop" }) %>

<div class="rounded-lg border border-emerald-200 bg-white p-6">
  <p class="text-sm font-medium text-emerald-700">Order placed</p>
  <h1 class="mt-1 text-2xl font-semibold tracking-tight">Thanks<%= order.customer_name ? ", " + order.customer_name : "" %>!</h1>
  <p class="mt-2 text-sm text-slate-600">
    We've received your order<%= order.customer_email ? " and sent a confirmation to " + order.customer_email : "" %>.
  </p>

  <dl class="mt-4 grid gap-1 text-sm">
    <div class="flex gap-2">
      <dt class="text-slate-500">Reference</dt>
      <dd data-testid="order-reference" class="font-mono text-xs text-slate-700"><%= order.reference %></dd>
    </div>
    <div class="flex gap-2">
      <dt class="text-slate-500">Status</dt>
      <dd><%- include("../partials/status", { status: order.status }) %></dd>
    </div>
  </dl>

  <p class="mt-4 text-xs text-slate-500">
    Keep this page's address — it's the only way back to your order.
  </p>
</div>

<div class="mt-6 -mx-4 overflow-x-auto border-y border-slate-200 bg-white sm:mx-0 sm:rounded-lg sm:border">
  <table class="w-full min-w-[520px] text-sm">
    <thead class="border-b border-slate-200 text-left text-xs uppercase tracking-wide text-slate-500">
      <tr>
        <th class="whitespace-nowrap px-4 py-3 font-medium">Product</th>
        <th class="whitespace-nowrap px-4 py-3 text-right font-medium">Unit price</th>
        <th class="whitespace-nowrap px-4 py-3 text-right font-medium">Qty</th>
        <th class="whitespace-nowrap px-4 py-3 text-right font-medium">Line total</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% order.items.forEach(function (item) { %>
        <tr data-testid="confirmation-row">
          <td class="px-4 py-3 font-medium text-slate-900"><%= item.product_name %></td>
          <td class="whitespace-nowrap px-4 py-3 text-right tabular-nums"><%= item.unit_price.toFixed(2) %></td>
          <td class="whitespace-nowrap px-4 py-3 text-right tabular-nums"><%= item.quantity %></td>
          <td class="whitespace-nowrap px-4 py-3 text-right tabular-nums"><%= (item.quantity * item.unit_price).toFixed(2) %></td>
        </tr>
      <% }); %>
    </tbody>
    <tfoot class="border-t border-slate-200 bg-slate-50">
      <tr>
        <td colspan="3" class="px-4 py-3 text-right text-xs uppercase tracking-wide text-slate-500">Total</td>
        <td data-testid="confirmation-total" class="whitespace-nowrap px-4 py-3 text-right font-semibold tabular-nums"><%= order.total.toFixed(2) %></td>
      </tr>
    </tfoot>
  </table>
</div>

<p class="mt-6">
  <a href="/" class="text-sm text-slate-600 hover:underline">Continue shopping</a>
</p>

<%- include("../partials/foot") %>
