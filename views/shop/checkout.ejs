<%- include("../partials/head", { title: title, nav: "shop" }) %>

<%- include("../partials/breadcrumb", { items: [
  { label: "Cart", href: "/cart" },
  { label: "Checkout" }
] }) %>

<h1 class="mb-6 text-2xl font-semibold tracking-tight">Checkout</h1>

<%- include("../partials/flash", { error: error }) %>

<div class="grid gap-6 lg:grid-cols-[2fr_1fr]">
  <form action="/checkout" method="post" class="space-y-5 rounded-lg border border-slate-200 bg-white p-6">
    <div>
      <label for="customer_name" class="block text-sm font-medium text-slate-700">Your name</label>
      <input id="customer_name" name="customer_name" type="text" required value="<%= values.customer_name %>"
             class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none">
    </div>

    <div>
      <label for="customer_email" class="block text-sm font-medium text-slate-700">Email</label>
      <input id="customer_email" name="customer_email" type="email" required value="<%= values.customer_email %>"
             class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none">
      <p class="mt-1 text-xs text-slate-500">We'll use this to confirm your order.</p>
    </div>

    <div class="flex items-center gap-3 pt-2">
      <button type="submit" class="rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">
        Place order
      </button>
      <a href="/cart" class="text-sm text-slate-600 hover:underline">Back to cart</a>
    </div>

    <p class="text-xs text-slate-500">No payment is taken — this places a pending order.</p>
  </form>

  <aside class="rounded-lg border border-slate-200 bg-white p-6">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Order summary</h2>
    <ul class="mt-3 space-y-2 text-sm">
      <% cart.items.forEach(function (item) { %>
        <li data-testid="summary-row" class="flex justify-between gap-3">
          <span class="text-slate-700"><%= item.quantity %> × <%= item.product.name %></span>
          <span class="tabular-nums"><%= item.lineTotal.toFixed(2) %></span>
        </li>
      <% }); %>
    </ul>
    <div class="mt-4 flex justify-between border-t border-slate-200 pt-3 text-sm font-semibold">
      <span>Total</span>
      <span data-testid="checkout-total" class="tabular-nums"><%= cart.total.toFixed(2) %></span>
    </div>
  </aside>
</div>

<%- include("../partials/foot") %>
