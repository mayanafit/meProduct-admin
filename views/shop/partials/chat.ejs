<%#
  Shop assistant widget. Included from the shop nav, so it can never appear on
  an /admin page. All behaviour lives in /js/chat.js.
%>
<div data-testid="chat-widget" class="fixed bottom-4 right-4 z-50 flex flex-col items-end gap-3">
  <div id="chat-panel" hidden
       class="flex h-[28rem] w-[min(22rem,calc(100vw-2rem))] flex-col overflow-hidden rounded-lg border border-slate-200 bg-white shadow-xl">
    <div class="flex items-center justify-between border-b border-slate-200 px-4 py-3">
      <div>
        <p class="text-sm font-semibold text-slate-900">Shop assistant</p>
        <p id="chat-status" class="text-xs text-slate-500">Checking…</p>
      </div>
      <button type="button" id="chat-close" aria-label="Close chat"
              class="rounded-md px-2 py-1 text-slate-400 hover:bg-slate-100 hover:text-slate-700">✕</button>
    </div>

    <div id="chat-log" class="flex-1 space-y-3 overflow-y-auto px-4 py-3 text-sm" aria-live="polite">
      <p class="text-slate-500">
        Ask me things like “do you have any mugs?”, “anything under 20?”, or “add a tee to my cart”.
      </p>
    </div>

    <form id="chat-form" class="flex items-center gap-2 border-t border-slate-200 p-3">
      <label for="chat-input" class="sr-only">Message</label>
      <input id="chat-input" name="message" type="text" autocomplete="off" maxlength="500"
             placeholder="Ask about a product…"
             class="min-w-0 flex-1 rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none">
      <button type="submit" id="chat-send"
              class="rounded-md bg-slate-900 px-3 py-2 text-sm font-medium text-white hover:bg-slate-700 disabled:bg-slate-300">
        Send
      </button>
    </form>
  </div>

  <button type="button" id="chat-launcher"
          class="rounded-full bg-slate-900 px-5 py-3 text-sm font-medium text-white shadow-lg hover:bg-slate-700">
    Ask a question
  </button>
</div>

<script src="/js/chat.js" defer></script>
