<%#
  Order status pill. Locals: status.
%>
<%
  const STATUS_STYLES = {
    pending: "bg-amber-100 text-amber-800",
    paid: "bg-blue-100 text-blue-800",
    shipped: "bg-emerald-100 text-emerald-800",
    cancelled: "bg-slate-200 text-slate-600"
  };
%>
<span class="inline-block rounded-full px-2 py-0.5 text-xs font-medium capitalize <%= STATUS_STYLES[status] || "bg-slate-100 text-slate-700" %>"><%= status %></span>
