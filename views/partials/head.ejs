<%#
  Shared layout opener. Locals:
    title — page title
    nav   — "admin" (default) | "shop" | "none"
  The storefront must never render the admin nav, and the error page is shown
  on both sides so it renders neither.
%>
<% const navKind = typeof nav === "string" ? nav : "admin"; %>
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title === "string" ? title : "meProduct" %> · meProduct</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="h-full bg-slate-50 text-slate-900 antialiased">
  <% if (navKind === "admin") { %>
    <%- include("nav") %>
  <% } else if (navKind === "shop") { %>
    <%- include("../shop/partials/nav") %>
  <% } else { %>
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto max-w-5xl px-4 py-4">
        <a href="/" class="font-semibold tracking-tight text-slate-900">meProduct</a>
      </div>
    </header>
  <% } %>
  <main class="mx-auto max-w-5xl px-4 py-8">
