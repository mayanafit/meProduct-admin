<%- include("partials/head", { title: title }) %>

<h1 class="mb-6 text-2xl font-semibold tracking-tight">Dashboard</h1>

<div class="grid gap-4 sm:grid-cols-3">
  <a href="/admin/products" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-slate-300">
    <p class="text-xs uppercase tracking-wide text-slate-500">Active products</p>
    <p data-testid="stat-products" class="mt-1 text-3xl font-semibold tabular-nums"><%= productCount %></p>
  </a>
  <a href="/admin/orders" class="rounded-lg border border-slate-200 bg-white p-5 hover:border-slate-300">
    <p class="text-xs uppercase tracking-wide text-slate-500">Orders</p>
    <p data-testid="stat-orders" class="mt-1 text-3xl font-semibold tabular-nums"><%= orderCount %></p>
  </a>
  <div class="rounded-lg border border-slate-200 bg-white p-5">
    <p class="text-xs uppercase tracking-wide text-slate-500">Low stock</p>
    <p data-testid="stat-low-stock" class="mt-1 text-3xl font-semibold tabular-nums <%= lowStock.length > 0 ? "text-amber-600" : "" %>"><%= lowStock.length %></p>
  </div>
</div>

<div class="mt-8 grid gap-8 lg:grid-cols-2">
  <section>
    <div class="mb-3 flex items-baseline justify-between">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Needs restocking</h2>
      <span class="text-xs text-slate-400"><%= threshold %> or fewer</span>
    </div>

    <% if (lowStock.length === 0) { %>
      <p class="rounded-lg border border-dashed border-slate-300 bg-white p-6 text-center text-sm text-slate-500">
        Stock levels look fine.
      </p>
    <% } else { %>
      <ul class="divide-y divide-slate-100 overflow-hidden rounded-lg border border-slate-200 bg-white">
        <% lowStock.forEach(function (product) { %>
          <li data-testid="low-stock-row" class="flex items-center justify-between px-4 py-3 text-sm">
            <a href="/admin/products/<%= product.id %>" class="font-medium text-slate-900 hover:underline"><%= product.name %></a>
            <span class="tabular-nums <%= product.stock_quantity === 0 ? "font-semibold text-red-600" : "text-amber-600" %>">
              <%= product.stock_quantity === 0 ? "Out of stock" : product.stock_quantity + " left" %>
            </span>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </section>

  <section>
    <div class="mb-3 flex items-baseline justify-between">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Recent orders</h2>
      <a href="/admin/orders" class="text-xs text-slate-500 hover:underline">View all</a>
    </div>

    <% if (recentOrders.length === 0) { %>
      <p class="rounded-lg border border-dashed border-slate-300 bg-white p-6 text-center text-sm text-slate-500">
        No orders yet. <a href="/admin/orders/new" class="underline">Place one</a>.
      </p>
    <% } else { %>
      <ul class="divide-y divide-slate-100 overflow-hidden rounded-lg border border-slate-200 bg-white">
        <% recentOrders.forEach(function (order) { %>
          <li data-testid="recent-order-row" class="flex items-center justify-between gap-3 px-4 py-3 text-sm">
            <a href="/admin/orders/<%= order.id %>" class="font-medium text-slate-900 hover:underline">
              #<%= order.id %> · <%= order.customer_name || "no name" %>
            </a>
            <span class="flex items-center gap-3">
              <%- include("partials/status", { status: order.status }) %>
              <span class="tabular-nums text-slate-600"><%= order.total.toFixed(2) %></span>
            </span>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </section>
</div>

<%- include("partials/foot") %>
