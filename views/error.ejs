<%# nav "none": this page is shown on both the shop and the admin, so it must
    not assume either navigation. %>
<%- include("partials/head", { title: title, nav: "none" }) %>

<div class="rounded-lg border border-red-200 bg-white p-6">
  <p class="text-sm font-medium text-red-600">Error <%= status %></p>
  <h1 class="mt-1 text-xl font-semibold text-slate-900"><%= message %></h1>
  <div class="mt-4 flex flex-wrap gap-4 text-sm">
    <a href="/" class="text-slate-600 underline hover:text-slate-900">Back to the shop</a>
    <a href="/admin" class="text-slate-600 underline hover:text-slate-900">Back to the dashboard</a>
  </div>
</div>

<%- include("partials/foot") %>
