<%- include("../partials/head", { title: title }) %>

<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-semibold tracking-tight">Products</h1>
  <a href="/admin/products/new" class="rounded-md bg-slate-900 px-3 py-2 text-sm font-medium text-white hover:bg-slate-700">New product</a>
</div>

<% if (products.length === 0) { %>
  <p class="rounded-lg border border-dashed border-slate-300 bg-white p-8 text-center text-sm text-slate-500">
    No products yet. <a href="/admin/products/new" class="underline">Add the first one</a>.
  </p>
<% } else { %>
  <%# min-w gives the table a floor so the wrapper actually scrolls on narrow
      screens instead of squashing columns; -mx-4 reclaims the page padding. %>
  <div class="-mx-4 overflow-x-auto border-y border-slate-200 bg-white sm:mx-0 sm:rounded-lg sm:border">
    <table class="w-full min-w-[600px] text-sm">
      <thead class="border-b border-slate-200 text-left text-xs uppercase tracking-wide text-slate-500">
        <tr>
          <th class="whitespace-nowrap px-4 py-3 font-medium">Name</th>
          <th class="whitespace-nowrap px-4 py-3 font-medium">SKU</th>
          <th class="whitespace-nowrap px-4 py-3 text-right font-medium">Price</th>
          <th class="whitespace-nowrap px-4 py-3 text-right font-medium">Stock</th>
          <th class="px-4 py-3"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% products.forEach(function (product) { %>
          <tr data-testid="product-row" data-product-id="<%= product.id %>" class="hover:bg-slate-50">
            <td class="px-4 py-3">
              <a href="/admin/products/<%= product.id %>" class="font-medium text-slate-900 hover:underline"><%= product.name %></a>
            </td>
            <td class="whitespace-nowrap px-4 py-3 font-mono text-xs text-slate-500"><%= product.sku || "—" %></td>
            <td class="whitespace-nowrap px-4 py-3 text-right tabular-nums"><%= product.price.toFixed(2) %></td>
            <td class="whitespace-nowrap px-4 py-3 text-right tabular-nums">
              <span class="<%= product.stock_quantity === 0 ? "font-semibold text-red-600" : product.stock_quantity < 10 ? "font-semibold text-amber-600" : "" %>">
                <%= product.stock_quantity %>
              </span>
            </td>
            <td class="px-4 py-3 text-right whitespace-nowrap">
              <a href="/admin/products/<%= product.id %>/edit" class="text-slate-600 hover:underline">Edit</a>
              <form action="/admin/products/<%= product.id %>" method="post" class="ml-3 inline">
                <input type="hidden" name="_method" value="DELETE">
                <button type="submit" class="text-red-600 hover:underline">Archive</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include("../partials/foot") %>
