<%- include("../partials/head", { title: title }) %>

<%
  const REASON_LABELS = {
    initial_stock: "Initial stock",
    order: "Order",
    order_cancelled: "Order cancelled",
    adjustment: "Manual adjustment"
  };
%>

<%- include("../partials/breadcrumb", { items: [
  { label: "Products", href: "/admin/products" },
  { label: product.name }
] }) %>

<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <div class="min-w-0">
    <h1 class="text-2xl font-semibold tracking-tight break-words"><%= product.name %></h1>
    <p class="mt-1 font-mono text-xs text-slate-500"><%= product.sku || "no sku" %></p>
    <% if (product.archived_at) { %>
      <span class="mt-2 inline-block rounded-full bg-slate-200 px-2 py-0.5 text-xs font-medium text-slate-600">Archived</span>
    <% } %>
  </div>
  <a href="/admin/products/<%= product.id %>/edit" class="rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium hover:bg-slate-50">Edit</a>
</div>

<%- include("../partials/flash", { error: error }) %>

<div class="grid gap-4 sm:grid-cols-3">
  <div class="rounded-lg border border-slate-200 bg-white p-4">
    <p class="text-xs uppercase tracking-wide text-slate-500">Price</p>
    <p class="mt-1 text-2xl font-semibold tabular-nums"><%= product.price.toFixed(2) %></p>
  </div>
  <div class="rounded-lg border border-slate-200 bg-white p-4">
    <p class="text-xs uppercase tracking-wide text-slate-500">In stock</p>
    <p class="mt-1 text-2xl font-semibold tabular-nums <%= product.stock_quantity === 0 ? "text-red-600" : "" %>"><%= product.stock_quantity %></p>
  </div>
  <div class="rounded-lg border border-slate-200 bg-white p-4">
    <p class="text-xs uppercase tracking-wide text-slate-500">Added</p>
    <p class="mt-1 text-sm text-slate-700"><%= product.created_at %></p>
  </div>
</div>

<% if (product.description) { %>
  <p class="mt-4 rounded-lg border border-slate-200 bg-white p-4 text-sm text-slate-700"><%= product.description %></p>
<% } %>

<section class="mt-8">
  <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-500">Adjust stock</h2>
  <form action="/admin/products/<%= product.id %>/stock" method="post" class="flex flex-wrap items-end gap-3 rounded-lg border border-slate-200 bg-white p-4">
    <div>
      <label for="delta" class="block text-sm font-medium text-slate-700">Change by</label>
      <input id="delta" name="delta" type="number" step="1" required placeholder="e.g. 10 or -3"
             class="mt-1 w-40 rounded-md border border-slate-300 px-3 py-2 text-sm tabular-nums focus:border-slate-500 focus:outline-none">
    </div>
    <button type="submit" class="rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">Record adjustment</button>
    <p class="text-xs text-slate-500">Logged in the history below.</p>
  </form>
</section>

<section class="mt-8">
  <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-500">Stock history</h2>
  <% if (movements.length === 0) { %>
    <p class="rounded-lg border border-dashed border-slate-300 bg-white p-6 text-center text-sm text-slate-500">No movements recorded.</p>
  <% } else { %>
    <div class="-mx-4 overflow-x-auto border-y border-slate-200 bg-white sm:mx-0 sm:rounded-lg sm:border">
      <table class="w-full min-w-[520px] text-sm">
        <thead class="border-b border-slate-200 text-left text-xs uppercase tracking-wide text-slate-500">
          <tr>
            <th class="whitespace-nowrap px-4 py-3 font-medium">When</th>
            <th class="whitespace-nowrap px-4 py-3 font-medium">Reason</th>
            <th class="whitespace-nowrap px-4 py-3 text-right font-medium">Change</th>
            <th class="whitespace-nowrap px-4 py-3 font-medium">Order</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% movements.forEach(function (movement) { %>
            <tr data-testid="movement-row">
              <td class="whitespace-nowrap px-4 py-3 text-slate-500"><%= movement.created_at %></td>
              <td class="px-4 py-3"><%= REASON_LABELS[movement.reason] || movement.reason %></td>
              <td class="px-4 py-3 text-right font-medium tabular-nums <%= movement.quantity_change < 0 ? "text-red-600" : "text-emerald-600" %>">
                <%= movement.quantity_change > 0 ? "+" : "" %><%= movement.quantity_change %>
              </td>
              <td class="px-4 py-3">
                <% if (movement.reference_id) { %>
                  <a href="/admin/orders/<%= movement.reference_id %>" class="text-slate-600 hover:underline">#<%= movement.reference_id %></a>
                <% } else { %>
                  <span class="text-slate-400">—</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<%- include("../partials/foot") %>
