<%- include("../partials/head", { title: title }) %>

<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-2xl font-semibold tracking-tight">Orders</h1>
  <a href="/admin/orders/new" class="rounded-md bg-slate-900 px-3 py-2 text-sm font-medium text-white hover:bg-slate-700">New order</a>
</div>

<% if (orders.length === 0) { %>
  <p class="rounded-lg border border-dashed border-slate-300 bg-white p-8 text-center text-sm text-slate-500">
    No orders yet. <a href="/admin/orders/new" class="underline">Place the first one</a>.
  </p>
<% } else { %>
  <div class="-mx-4 overflow-x-auto border-y border-slate-200 bg-white sm:mx-0 sm:rounded-lg sm:border">
    <table class="w-full min-w-[680px] text-sm">
      <thead class="border-b border-slate-200 text-left text-xs uppercase tracking-wide text-slate-500">
        <tr>
          <th class="whitespace-nowrap px-4 py-3 font-medium">Order</th>
          <th class="whitespace-nowrap px-4 py-3 font-medium">Customer</th>
          <th class="whitespace-nowrap px-4 py-3 font-medium">Status</th>
          <th class="whitespace-nowrap px-4 py-3 text-right font-medium">Items</th>
          <th class="whitespace-nowrap px-4 py-3 text-right font-medium">Total</th>
          <th class="whitespace-nowrap px-4 py-3 font-medium">Placed</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% orders.forEach(function (order) { %>
          <tr data-testid="order-row" data-order-id="<%= order.id %>" class="hover:bg-slate-50">
            <td class="px-4 py-3">
              <a href="/admin/orders/<%= order.id %>" class="font-medium text-slate-900 hover:underline">#<%= order.id %></a>
            </td>
            <td class="px-4 py-3"><%= order.customer_name || "—" %></td>
            <td class="px-4 py-3"><%- include("../partials/status", { status: order.status }) %></td>
            <td class="whitespace-nowrap px-4 py-3 text-right tabular-nums"><%= order.item_count %></td>
            <td class="whitespace-nowrap px-4 py-3 text-right tabular-nums"><%= order.total.toFixed(2) %></td>
            <td class="whitespace-nowrap px-4 py-3 text-slate-500"><%= order.created_at %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include("../partials/foot") %>
