<%- include("../partials/head", { title: title }) %>

<%- include("../partials/breadcrumb", { items: [
  { label: "Orders", href: "/admin/orders" },
  { label: "New" }
] }) %>

<h1 class="mb-6 text-2xl font-semibold tracking-tight">New order</h1>

<%- include("../partials/flash", { error: error }) %>

<% if (products.length === 0) { %>
  <p class="rounded-lg border border-dashed border-slate-300 bg-white p-8 text-center text-sm text-slate-500">
    There are no products to order. <a href="/admin/products/new" class="underline">Add one first</a>.
  </p>
<% } else { %>
  <form action="/admin/orders" method="post" class="space-y-6">
    <div class="rounded-lg border border-slate-200 bg-white p-6">
      <label for="customer_name" class="block text-sm font-medium text-slate-700">Customer</label>
      <input id="customer_name" name="customer_name" type="text" value="<%= customerName %>"
             class="mt-1 w-full max-w-sm rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-slate-500 focus:outline-none">
      <p class="mt-1 text-xs text-slate-500">Optional.</p>
    </div>

    <div class="-mx-4 overflow-x-auto border-y border-slate-200 bg-white sm:mx-0 sm:rounded-lg sm:border">
      <table class="w-full min-w-[560px] text-sm">
        <thead class="border-b border-slate-200 text-left text-xs uppercase tracking-wide text-slate-500">
          <tr>
            <th class="whitespace-nowrap px-4 py-3 font-medium">Product</th>
            <th class="whitespace-nowrap px-4 py-3 text-right font-medium">Price</th>
            <th class="whitespace-nowrap px-4 py-3 text-right font-medium">In stock</th>
            <th class="whitespace-nowrap px-4 py-3 text-right font-medium">Quantity</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% products.forEach(function (product) { %>
            <tr data-testid="orderable-row" class="<%= product.stock_quantity === 0 ? "opacity-50" : "" %>">
              <td class="px-4 py-3">
                <span class="font-medium text-slate-900"><%= product.name %></span>
                <span class="ml-2 font-mono text-xs text-slate-400"><%= product.sku || "" %></span>
              </td>
              <td class="whitespace-nowrap px-4 py-3 text-right tabular-nums"><%= product.price.toFixed(2) %></td>
              <td class="px-4 py-3 text-right tabular-nums <%= product.stock_quantity === 0 ? "text-red-600" : "" %>"><%= product.stock_quantity %></td>
              <td class="px-4 py-3 text-right">
                <input type="number" step="1" min="0" max="<%= product.stock_quantity %>"
                       name="quantity_<%= product.id %>"
                       value="<%= quantities[product.id] || "" %>"
                       <%= product.stock_quantity === 0 ? "disabled" : "" %>
                       placeholder="0"
                       class="w-24 rounded-md border border-slate-300 px-3 py-2 text-right text-sm tabular-nums focus:border-slate-500 focus:outline-none disabled:bg-slate-100">
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <div class="flex items-center gap-3">
      <button type="submit" class="rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">Place order</button>
      <a href="/admin/orders" class="text-sm text-slate-600 hover:underline">Cancel</a>
      <p class="text-xs text-slate-500">Stock is reserved as soon as the order is placed.</p>
    </div>
  </form>
<% } %>

<%- include("../partials/foot") %>
