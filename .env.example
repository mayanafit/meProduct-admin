PORT=3000
DB_PATH=./data.sqlite
SESSION_SECRET=change-me

# Shop assistant. Any OpenAI-compatible endpoint works — Ollama, LM Studio,
# llama.cpp's llama-server, vLLM. Defaults assume a local Ollama.
#   ollama serve
#   ollama pull llama3.2:3b
# Check your model is good enough for this task with: pnpm eval:model
# Sizing matters more than you'd think: on an 8 GB machine a 3B model answers
# in under a second, while an 8B swaps and takes minutes.
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
LLM_API_KEY=ollama
LLM_TIMEOUT_MS=20000
